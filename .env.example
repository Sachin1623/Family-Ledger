# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP settings used to send 4-digit email OTP codes for email login.
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="system@thirteenapps.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
EMAIL_FROM="FamilyLedger <system@thirteenapps.com>"

# FIELD_ENCRYPTION_SECRET: master secret every per-document encryption key (Goals, Financial
# Accounts) is derived from — see src/lib/fieldCrypto.ts. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# then NEVER rotate it in production — rotating makes every already-encrypted document
# permanently undecryptable. Back it up somewhere durable (the credentials vault), not just .env.
FIELD_ENCRYPTION_SECRET="MY_FIELD_ENCRYPTION_SECRET"
