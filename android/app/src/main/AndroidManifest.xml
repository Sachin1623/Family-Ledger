<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The RECORD_AUDIO permission (in-game voice chat) makes the Android manifest merger
         auto-imply <uses-feature android:name="android.hardware.microphone" required="true">,
         which silently excludes every device without a microphone from the Play Store listing
         entirely (Play Console flagged this as "no longer supports N devices" on the first
         release after voice chat was added). Declaring it explicitly as NOT required restores
         those devices — voice chat just won't be available there (the feature already degrades
         gracefully; see GameVoiceChat.tsx's `supported` check), it doesn't need to block the
         whole app. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: verified deep links so invite/join links open this app
                 directly instead of a browser tab. Verified against /.well-known/assetlinks.json
                 served by the backend at this same host (see server.ts). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="familyledger.thirteenapps.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Medicine reminders' alarm-clock-style takeover — see the AlarmScheduler.java doc
             comment for why this is all custom native code rather than @capacitor/local-notifications. -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".AlarmBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBar" />
    </application>

    <!-- Package visibility (Android 11+ / API 30+): without this, PackageManager.
         queryIntentActivities() can't see other apps' SEND handlers, so AiSharePlugin would
         never find any AI app to share to even when one's installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor-community/contacts — browsing contacts to invite to a group by SMS. The
         plugin's native code requires WRITE_CONTACTS declared too, even though this app only
         ever calls its read methods (getContacts) — confirmed by the plugin's own runtime error
         ("Missing the following permissions in AndroidManifest.xml: WRITE_CONTACTS") when only
         READ_CONTACTS was present. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- In-game voice chat (WebRTC getUserMedia) — Capacitor's own BridgeWebChromeClient already
         forwards the WebView's mic permission prompt to these, no custom native code needed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- BP/glucose/shared/todo reminders are scheduled as native local notifications with
         @capacitor/local-notifications (see healthReminders.ts etc.), which asks AlarmManager for
         an EXACT alarm at each time. On Android 12+ (API 31+), an exact alarm silently falls
         back to an inexact one — delivered whenever Doze/battery-saving next wakes the app, which
         can be minutes to hours late — unless this permission is declared AND the user has granted
         it (Settings > Alarms & reminders; see requestExactAlarmPermission() in pushNotifications.ts
         for the in-app prompt that sends them there). Declaring it here is what makes
         canScheduleExactAlarms()/checkExactNotificationSetting() possible at all; without it every
         reminder in the app is inexact for every user, regardless of that in-app prompt. This same
         permission is also what AlarmScheduler.java (below) uses directly for medicine reminders'
         alarm-clock-style takeover — one shared Android capability, two different call sites. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Medicine reminders' alarm-clock-style takeover (see AlarmReceiver/AlarmRingingService/
         AlarmActivity/AlarmClockPlugin under android/app/src/main/java/com/familyledger/app) — a
         custom native feature, since @capacitor/local-notifications has no concept of a
         full-screen, rings-over-silent-mode takeover the way a real alarm clock does. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
</manifest>
