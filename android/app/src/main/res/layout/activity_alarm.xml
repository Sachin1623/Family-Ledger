<?xml version="1.0" encoding="utf-8"?>
<!-- The native "alarm is ringing" card (see AlarmActivity.java): a compact card pinned to the top of
     the screen over whatever is showing, saying plainly WHAT is ringing — not a full-screen takeover.
     Deliberately plain Android widgets, not a WebView — this has to render instantly and reliably
     regardless of network conditions or whether the app's JS bundle has loaded. Colors match the
     app's own brand tokens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:background="@drawable/alarm_card_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/alarmTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Medicine reminder (2 due)" />

        <TextView
            android:id="@+id/alarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="4:00 PM" />
    </LinearLayout>

    <!-- What is ringing: one line per medicine / item, large and plain. -->
    <TextView
        android:id="@+id/alarmBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:lineSpacingExtra="4dp"
        tools:text="preeti rajput: LINID (1 tab) — Afternoon\npreeti rajput: Ashpro (1) — Afternoon" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/alarmDismissButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Dismiss"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#DC2626" />

        <Button
            android:id="@+id/alarmSnoozeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Snooze 10"
            android:textColor="#003044"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B" />

        <Button
            android:id="@+id/alarmOpenButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Open"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#0F4761" />
    </LinearLayout>

</LinearLayout>
