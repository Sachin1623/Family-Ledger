<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Touched to force a fresh Xcode Cloud build after capacitor.config.ts's skipNativeAuth fix —
     that file lives outside ios/, which is Xcode Cloud's actual trigger scope, so it needed a
     tracked change under here too. See the "Fix Apple sign-in duplicate credential" commit. -->
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>FamilyLedger</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.192700919713-pk1hgm9p9eqmjko4qtfejsq0tk24aj3l</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- @capacitor-firebase/messaging's own recommended setup — prevents Firebase's SDK from
	     auto-initializing (and requesting a token) before this app has actually asked for
	     notification permission; getToken() (see pushNotifications.ts) explicitly re-enables
	     auto-init itself once called. -->
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Answers App Store Connect's export-compliance question at upload time, instead of it
	     prompting on every single build. FamilyLedger only uses standard, exempt encryption —
	     HTTPS for all network traffic, and AES-256-GCM via the platform's own WebCrypto API for
	     field-level encryption of financial/goal amounts (see src/lib/fieldCrypto.ts) — never a
	     proprietary or non-standard algorithm, and encryption isn't the app's own core purpose. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSFaceIDUsageDescription</key>
	<string>FamilyLedger uses Face ID to unlock the app when App Lock is enabled in your settings.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Used to take a photo of a receipt so you can attach it to an expense.</string>
	<key>NSContactsUsageDescription</key>
	<string>Used to browse your contacts so you can invite them to a group by SMS.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used for voice chat with other players during a multiplayer game.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to attach an existing photo of a receipt to an expense.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
