<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:familyledger.thirteenapps.com</string>
	</array>
	<!-- com.apple.developer.usernotifications.critical-alerts REMOVED for now — it requires Apple
	     to separately grant this app's App ID the Critical Alerts capability (via
	     https://developer.apple.com/contact/request/notifications-critical-alerts-entitlement/,
	     filed manually, outside Xcode/this repo) before the App ID actually has it. Until that
	     grant comes through, DECLARING it here (even though it's functionally inert —
	     medicineReminders.ts's MEDICINE_INTERRUPTION_LEVEL already stays 'timeSensitive' without
	     it) makes automatic provisioning-profile matching fail at export time, since Xcode can't
	     find/generate a profile satisfying an entitlement the App ID doesn't have — this is what
	     broke the Xcode Cloud "Export archive" step across all three distribution methods at
	     once. Re-add this key (and flip MEDICINE_INTERRUPTION_LEVEL to 'critical') once Apple
	     confirms the grant. -->
</dict>
</plist>
